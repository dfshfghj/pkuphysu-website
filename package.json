{
  "name": "pkuphysu-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .js,.vue,.svelte",
    "lint:fix": "eslint . --ext .js,.vue,.svelte --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "@iconify-json/ri": "^1.2.10",
    "@mdit/plugin-img-lazyload": "^0.22.2",
    "@mdit/plugin-img-size": "^0.22.5",
    "@mdit/plugin-ins": "^0.22.2",
    "@mdit/plugin-katex": "^0.23.2",
    "@mdit/plugin-mark": "^0.22.2",
    "@mdit/plugin-tasklist": "^0.22.3",
    "@tailwindcss/vite": "^4.2.2",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "js-sha256": "^0.11.1",
    "jsencrypt": "^3.5.4",
    "katex": "^0.16.44",
    "lint-staged": "^16.4.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "marked": "^17.0.5",
    "markstream-vue": "^0.0.3",
    "minidenticons": "^4.2.1",
    "pinia": "^3.0.4",
    "prettier": "^3.8.1",
    "reka-ui": "^2.9.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "unplugin-icons": "^23.0.1",
    "vditor": "^3.11.2",
    "vue": "^3.5.31",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "sass-embedded": "^1.98.0",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitepress": "2.0.0-alpha.15",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  }
}
