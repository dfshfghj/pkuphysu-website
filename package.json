{
  "name": "pkuphysu-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .js,.vue,.svelte",
    "lint:fix": "eslint . --ext .js,.vue,.svelte --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/ri": "^1.2.10",
    "@mdit/plugin-img-lazyload": "^0.22.2",
    "@mdit/plugin-img-size": "^0.22.5",
    "@mdit/plugin-ins": "^0.22.2",
    "@mdit/plugin-katex": "^0.23.2",
    "@mdit/plugin-mark": "^0.22.2",
    "@mdit/plugin-tasklist": "^0.22.3",
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^13.9.0",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.1",
    "element-plus": "^2.13.3",
    "highlight.js": "^11.11.1",
    "jsencrypt": "^3.5.4",
    "katex": "^0.16.33",
    "lint-staged": "^16.3.2",
    "markdown-it": "^14.1.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "marked": "^17.0.4",
    "markstream-vue": "^0.0.3",
    "minidenticons": "^4.2.1",
    "pinia": "^3.0.4",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "unplugin-icons": "^22.5.0",
    "vditor": "^3.11.2",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^9.39.3",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "sass-embedded": "^1.97.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitepress": "2.0.0-alpha.15"
  }
}
