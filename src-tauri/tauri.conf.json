{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PKUPhySU",
  "version": "0.2.0",
  "identifier": "cn.pkuphysu.website",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PKUPhySU",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
